{
  "name": "universal-import-v4",
  "version": "4.0.0",
  "private": true,
  "description": "V4 async event-driven import pipeline with full observability (exam submission)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx src/lib/db/migrate.ts",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "seed": "dotenv -e .env.local -- tsx scripts/seed-data.ts",
    "seed:clean": "dotenv -e .env.local -- tsx scripts/seed-data.ts --clean",
    "generate-test-data": "dotenv -e .env.local -- tsx scripts/generate-test-data.ts",
    "worker": "dotenv -e .env.local -- tsx scripts/worker.ts",
    "load-test": "dotenv -e .env.local -- tsx scripts/load-test.ts",
    "test": "dotenv -e .env.local -- vitest run",
    "test:watch": "dotenv -e .env.local -- vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^1.0.0",
    "bullmq": "^5.34.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.6.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "saxes": "^6.0.0",
    "shadcn": "4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unzipper": "^0.12.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
