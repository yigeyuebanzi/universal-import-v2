# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:postgres@localhost:5433/import_v4
REDIS_URL=

# ---- Redis (BullMQ queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---- Uploaded file storage ----
# local directory for development; on Vercel set BLOB_READ_WRITE_TOKEN
UPLOAD_DIR=./data/uploads
BLOB_READ_WRITE_TOKEN=

# ---- Security ----
# Optional. When set, all /api/import-tasks*, /api/traces*, /api/import-monitor*
# require "x-api-key: <IMPORT_API_KEY>".
IMPORT_API_KEY=
CRON_SECRET=

# ---- Pipeline tuning ----
BATCH_SIZE=1000
WORKER_CONCURRENCY=4
QUEUE_DRIVER=redis
FILE_STORAGE=local
CRON_PROCESS_BATCHES=4
DISPATCH_POLL_MS=1000
SWEEP_INTERVAL_MS=30000
SKU_CHECK_TIMEOUT_MS=3000
BATCH_MAX_RETRIES=3
STALE_BATCH_MINUTES=5
REQUIRED_FIELDS=externalCode,receiverName,receiverPhone,skuCode,skuQuantity

# ---- Optional AI rule generation (not part of import hot path) ----
OPENAI_API_KEY=

# ---- Public base URL used by load test / links ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
